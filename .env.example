# Stripe secret key — get it from https://dashboard.stripe.com/apikeys
# Use a TEST key (starts with sk_test_) while developing.
# In production on Vercel, set this in Project → Settings → Environment Variables.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ── x402 bot paywall (see README → "x402 bot paywall") ──
# X402_ENABLED=false disables the paywall entirely.
X402_ENABLED=true
X402_PAY_TO=0x0ba3b8796ce61ef8Cbd11A7F33Be31F1Fd4A03B3
X402_PRICE=$0.001
# Base mainnet (USDC). Use eip155:84532 (Base Sepolia) for testing with the public facilitator.
X402_NETWORK=eip155:8453
# If both CDP keys are set, the Coinbase CDP facilitator is used (required for Base mainnet).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Otherwise this facilitator is used (default https://x402.org/facilitator — testnets only).
X402_FACILITATOR_URL=https://x402.org/facilitator
